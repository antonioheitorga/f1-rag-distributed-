# Variáveis de ambiente do projeto f1-rag-distributed.
#
# Todas as envs aceitas pelo sistema estão declaradas em config.py com seus
# defaults. Este arquivo replica a lista para servir como template. Copie
# para .env e ajuste apenas o que precisa sobrescrever.
#
# Valores listados aqui são os defaults reais do código. Comentar a linha
# significa "use o default". Descomentar e mudar significa "use este valor".

# ============================================================================
# Modelos (servidos via Ollama)
# ============================================================================

# Modelo de geração usado pelo agente Generator
LLM_MODEL=llama3.1:8b

# Modelo de embedding usado pelo Retriever e workers de ingestão
EMBED_MODEL=nomic-embed-text

# Endpoint HTTP do Ollama. Em deploy distribuído, cada EC2 tem seu próprio
# Ollama em localhost. Em docker-compose, sobrescrever para o nome do serviço.
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Chunking
# ============================================================================

CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ============================================================================
# ChromaDB (vector store)
# ============================================================================

CHROMA_COLLECTION=fia_2026_regulations

# Diretório de persistência do ChromaDB. Sem default global: cada caller
# decide o path apropriado. Em workers EC2 distribuídos, setar para algo
# como /data/vectorstore. Em dev local, usar ./dados/vectorstore.
# CHROMA_PERSIST_DIR=./dados/vectorstore

# ============================================================================
# Retriever
# ============================================================================

# Limiar de similaridade abaixo do qual o orquestrador aciona o Web Searcher
RETRIEVER_THRESHOLD=0.75

# Número de chunks retornados pela busca vetorial
RETRIEVER_TOP_K=5

# ============================================================================
# Tavily (busca web externa)
# ============================================================================

# Chave de API obrigatória para o fallback web. Sem default por segurança.
TAVILY_API_KEY=

# Máximo de resultados retornados por busca
TAVILY_MAX_RESULTS=5

# ============================================================================
# AWS (SQS, CloudWatch)
# ============================================================================

# Endpoint customizado. Vazio = AWS real. Em dev com LocalStack, definir:
# AWS_ENDPOINT_URL=http://localhost:4566
AWS_ENDPOINT_URL=

# Região AWS
AWS_DEFAULT_REGION=us-east-1

# Nome da fila SQS principal
SQS_QUEUE_NAME=ingestion-jobs

# Nome da Dead Letter Queue. Por convenção, {SQS_QUEUE_NAME}-dlq.
# SQS_DLQ_NAME=ingestion-jobs-dlq

# Tentativas antes de rotear mensagem para DLQ
SQS_MAX_RECEIVE_COUNT=3

# Segundos que uma mensagem fica invisível após o receive
SQS_VISIBILITY_TIMEOUT=600

# Long polling: tempo máximo de espera por mensagens novas
SQS_POLL_WAIT_SECONDS=20

# ============================================================================
# Worker
# ============================================================================

# Segundos sem mensagens antes do worker encerrar. 0 = nunca encerrar (produção).
# Valor positivo é útil em dev/demo para o container parar sozinho após ficar idle.
WORKER_IDLE_TIMEOUT_SEC=0

# ============================================================================
# CloudWatch (métricas)
# ============================================================================

CLOUDWATCH_NAMESPACE=F1RagHarness

# ============================================================================
# Paths gerais
# ============================================================================

# Onde os traces JSON de cada execução do orquestrador são salvos
TRACES_DIR=./traces

# ============================================================================
# Telemetria de bibliotecas externas
# ============================================================================

# Silencia warnings repetidos da telemetria do ChromaDB (incompatibilidade
# conhecida entre ChromaDB 0.5.x e versão do PostHog instalada). Default
# True deixa o output limpo. Defina como False para ver as mensagens
# se precisar diagnosticar problemas reais de telemetria.
SILENCE_CHROMA_TELEMETRY=True
